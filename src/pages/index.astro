---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CornerMarks from '../components/CornerMarks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, aboutCopy, services, servicesIntro, servicesOutro } from '../data/site';
import { featuredProjects } from '../data/projects';

const ogImage =
  'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1200&h=630&q=65';
const heroImage =
  'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1920&h=1080&q=65';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': `${site.url}/#organization`,
      name: site.legalName,
      alternateName: site.name,
      url: site.url,
      logo: `${site.url}/favicon.svg`,
      image: ogImage,
      description: site.description,
      foundingDate: site.founded,
      telephone: site.phoneHref,
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.locality,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: 'NG',
      },
      areaServed: { '@type': 'Country', name: 'Nigeria' },
      sameAs: [site.social.linkedin, site.social.facebook],
      knowsAbout: services.map((service) => service.title),
      hasCredential: site.certifications.map((certification) => ({
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'certification',
        name: certification,
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      publisher: { '@id': `${site.url}/#organization` },
      inLanguage: 'en-NG',
    },
  ],
};
---

<Layout
  title="Bunutech Construction | Building & Civil Engineering Contractors in Nigeria"
  description={site.description}
  image={ogImage}
  imageAlt="Bunutech Construction site with cranes in Nigeria"
  preloadImage={{ href: heroImage }}
  jsonLd={structuredData}
>
  <Hero />

  <!-- About -->
  <section id="about" aria-labelledby="about-heading" class="scroll-mt-6 bg-white">
    <div class="grid lg:grid-cols-2">
      <div class="px-6 py-14 sm:px-10 sm:py-16 lg:py-20 lg:pr-[7%] lg:pl-[8%] xl:pl-[10%]">
        <h2 id="about-heading" class="eyebrow">About Us</h2>
        <hr class="rule-brand" />
        {
          aboutCopy.map((paragraph, index) => (
            <p class:list={['body-copy text-justify', index === 0 ? 'mt-6' : 'mt-4']}>{paragraph}</p>
          ))
        }
        <a href="/about" class="link-underline mt-8 text-lg">Learn more</a>
      </div>

      <div class="relative min-h-[300px] sm:min-h-[420px] lg:min-h-[520px]">
        <img
          src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&h=900&q=65"
          alt="Bunutech Construction engineers reviewing progress on a construction site"
          width="1200"
          height="900"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <CornerMarks />
      </div>
    </div>
  </section>

  <div class="h-[1.3em] bg-mist" aria-hidden="true"></div>

  <!-- Services -->
  <section id="services" aria-labelledby="services-heading" class="scroll-mt-6 bg-white">
    <div class="grid lg:grid-cols-2">
      <div class="relative order-2 min-h-[300px] sm:min-h-[420px] lg:order-1 lg:min-h-[560px]">
        <img
          src="https://images.unsplash.com/photo-1516156008625-3a9d6067fab5?auto=format&fit=crop&w=1200&h=1000&q=65"
          alt="Bunutech Construction specialists installing the structure of a commercial building"
          width="1200"
          height="1000"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <CornerMarks />
      </div>

      <div class="order-1 px-6 py-14 sm:px-10 sm:py-16 lg:order-2 lg:py-20 lg:pr-[8%] lg:pl-[7%]">
        <h2 id="services-heading" class="eyebrow">Our Services</h2>
        <hr class="rule-brand" />
        <p class="body-copy mt-6 text-justify">{servicesIntro}</p>

        <ul class="mt-8 space-y-1">
          {
            services.map((service) => (
              <li>
                <a
                  href={`/contact?subject=${encodeURIComponent(service.subject)}`}
                  class="group flex items-center justify-between gap-5 border-b border-line py-4"
                >
                  <span class="text-lg font-bold text-ink transition-colors group-hover:text-brand">
                    {service.title}
                  </span>
                  <svg
                    class="shrink-0 text-brand transition-transform duration-200 group-hover:translate-x-1"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="body-copy mt-8 text-justify">{servicesOutro}</p>
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section id="projects" aria-labelledby="projects-heading" class="scroll-mt-6 bg-mist px-2 py-5 sm:px-4 sm:py-6">
    <div class="mx-auto w-full bg-white p-6 shadow-card sm:p-10 lg:p-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="projects-heading" class="font-display text-2xl tracking-wide text-muted sm:text-3xl">
          Featured Projects
        </h2>
        <p class="text-[11px] tracking-[0.14em] text-muted uppercase">Selected work across Nigeria</p>
      </div>

      <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredProjects(3).map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>

      <div class="mt-9 text-center">
        <a href="/projects" class="btn-primary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- Contact call to action -->
  <section class="relative isolate overflow-hidden bg-ink py-16 sm:py-20 lg:py-24" aria-labelledby="cta-heading">
    <img
      src="https://images.unsplash.com/photo-1531834685032-c34bf0d84c77?auto=format&fit=crop&w=1600&h=900&q=55"
      alt=""
      aria-hidden="true"
      width="1600"
      height="900"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 -z-10 bg-ink/75"></div>

    <div class="wrap">
      <h2 id="cta-heading" class="sr-only">Work with Bunutech Construction</h2>
      <p class="max-w-5xl text-lg leading-8 text-justify text-white sm:text-xl sm:leading-9 lg:text-[25px] lg:leading-[30px]">
        Whether it be a project of small or large scale, private or commercial, we bring technical expertise and
        hands-on site experience to deliver quality from the design stage through to completion.
      </p>
      <div class="mt-8 text-center">
        <a href="/contact" class="btn-primary">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
