---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CornerMarks from '../../components/CornerMarks.astro';
import { site } from '../../data/site';
import { projects, projectUrl, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(index - 1 + projects.length) % projects.length],
      next: projects[(index + 1) % projects.length],
    },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const url = `${site.url}${projectUrl(project)}`;
const ogImage = project.image;
const pad = (n: number) => String(n).padStart(2, '0');
const stepId = (index: number) => `step-${index + 1}`;

const facts = [
  { label: 'Location', value: project.location },
  { label: 'Category', value: project.category },
  { label: 'Status', value: project.status },
  { label: 'Client', value: project.client },
  { label: 'Year', value: project.year },
  { label: 'Stages', value: `${project.steps.length} steps` },
].filter((fact) => fact.value);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: `${project.name} | Bunutech Construction`,
      description: project.summary,
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#organization` },
      primaryImageOfPage: ogImage,
      inLanguage: 'en-NG',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects` },
        { '@type': 'ListItem', position: 3, name: project.name, item: url },
      ],
    },
  ],
};
---

<Layout
  title={`${project.name} | Bunutech Construction`}
  description={project.summary}
  image={ogImage}
  imageAlt={project.alt}
  type="article"
  jsonLd={structuredData}
>
  <PageHero
    title={project.name}
    eyebrow={`${project.category} · ${project.location}`}
    description={project.summary}
    image={project.image}
    imageAlt={project.alt}
    crumbs={[{ label: 'Projects', href: '/projects' }]}
  />

  <!-- Overview -->
  <section aria-labelledby="overview-heading" class="bg-white py-14 sm:py-16 lg:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 id="overview-heading" class="eyebrow">Project Overview</h2>
        <hr class="rule-brand" />
        {
          project.description.map((paragraph, index) => (
            <p class:list={['body-copy text-justify', index === 0 ? 'mt-6' : 'mt-4']}>{paragraph}</p>
          ))
        }

        {
          project.scope.length > 0 && (
            <>
              <h3 class="mt-10 font-display text-lg tracking-wide text-ink uppercase">Scope of Work</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.scope.map((item) => (
                  <li class="border border-line px-3 py-1.5 text-[12px] tracking-[0.08em] text-muted uppercase">
                    {item}
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      <aside class="lg:col-span-5" aria-label="Project details">
        <dl class="border-t-4 border-brand bg-mist p-6 sm:p-8">
          {
            facts.map((fact) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-line py-3 last:border-0">
                <dt class="text-[11px] tracking-[0.14em] text-muted uppercase">{fact.label}</dt>
                <dd class="text-right font-bold text-ink">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <a href="/contact?subject=Project%20enquiry" class="btn-primary mt-6 w-full">Discuss a similar project</a>
      </aside>
    </div>
  </section>

  <!-- Step-by-step process -->
  <section aria-labelledby="process-heading" class="bg-mist py-14 sm:py-16 lg:py-20">
    <div class="wrap">
      <div class="max-w-3xl">
        <h2 id="process-heading" class="eyebrow">How It Was Built</h2>
        <hr class="rule-brand" />
        <p class="body-copy mt-6">
          A step-by-step look at the project, from the first drawings to the finished building.
        </p>
      </div>

      <!-- Stage navigator -->
      <nav aria-label="Construction stages" class="-mx-[5vw] mt-10 overflow-x-auto px-[5vw] pb-2">
        <ol class="flex min-w-max gap-0">
          {
            project.steps.map((step, index) => (
              <li class="relative flex-1">
                <a href={`#${stepId(index)}`} class="group flex min-w-36 flex-col items-start pr-6">
                  <span class="relative z-10 flex h-10 w-10 items-center justify-center bg-brand font-display text-sm text-white transition-colors group-hover:bg-ink">
                    {pad(index + 1)}
                  </span>
                  <span class="mt-3 text-[11px] leading-snug font-bold tracking-[0.1em] text-ink uppercase group-hover:text-brand">
                    {step.title}
                  </span>
                </a>
                {index < project.steps.length - 1 && (
                  <span class="absolute top-5 right-0 left-10 h-px bg-brand/40" aria-hidden="true" />
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <!-- Stages -->
      <ol class="mt-12 space-y-10 sm:space-y-14 lg:mt-16 lg:space-y-20">
        {
          project.steps.map((step, index) => {
            const reversed = index % 2 === 1;
            return (
              <li id={stepId(index)} class="scroll-mt-28 grid items-center gap-6 bg-white shadow-card lg:grid-cols-12 lg:gap-0">
                <figure class:list={['relative lg:col-span-7', reversed && 'lg:order-2']}>
                  {
                    step.images.length > 1 ? (
                      <div
                        class="relative aspect-[3/2] w-full overflow-hidden bg-ink"
                        role="group"
                        aria-roledescription="carousel"
                        aria-label={`${step.title} images`}
                        data-gallery
                      >
                        <div class="flex h-full transition-transform duration-500 ease-out" data-gallery-track>
                          {step.images.map((src, imageIndex) => (
                            <div
                              class="h-full w-full shrink-0"
                              role="group"
                              aria-roledescription="slide"
                              aria-label={`${imageIndex + 1} of ${step.images.length}`}
                              aria-hidden={imageIndex === 0 ? 'false' : 'true'}
                              inert={imageIndex !== 0}
                              data-gallery-slide
                            >
                              <img
                                src={src}
                                alt={
                                  imageIndex === 0
                                    ? step.alt
                                    : `${step.alt} — image ${imageIndex + 1} of ${step.images.length}`
                                }
                                width="1200"
                                height="800"
                                class="h-full w-full object-cover"
                                loading={index === 0 && imageIndex === 0 ? 'eager' : 'lazy'}
                                decoding="async"
                              />
                            </div>
                          ))}
                        </div>

                        <button
                          type="button"
                          class="absolute top-1/2 left-2 z-10 grid h-10 w-10 -translate-y-1/2 place-items-center border border-white/40 bg-ink/40 text-white transition-colors hover:bg-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                          aria-label="Previous image"
                          data-gallery-prev
                        >
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
                          </svg>
                        </button>
                        <button
                          type="button"
                          class="absolute top-1/2 right-2 z-10 grid h-10 w-10 -translate-y-1/2 place-items-center border border-white/40 bg-ink/40 text-white transition-colors hover:bg-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                          aria-label="Next image"
                          data-gallery-next
                        >
                          <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                          </svg>
                        </button>
                        <p
                          class="absolute right-3 bottom-3 border border-white/40 bg-ink/50 px-2.5 py-1 text-[11px] tracking-[0.1em] text-white"
                          aria-live="polite"
                          data-gallery-counter
                        >
                          1 / {step.images.length}
                        </p>
                      </div>
                    ) : (
                      <img
                        src={step.images[0]}
                        alt={step.alt}
                        width="1200"
                        height="800"
                        class="aspect-[3/2] w-full object-cover"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    )
                  }
                  <CornerMarks />
                  <figcaption class="sr-only">{step.alt}</figcaption>
                </figure>

                <div class:list={['px-6 pb-8 sm:px-10 lg:col-span-5 lg:py-10', reversed ? 'lg:order-1 lg:pr-12' : 'lg:pl-12']}>
                  <p class="flex items-center gap-4">
                    <span class="font-display text-5xl leading-none text-brand sm:text-6xl" aria-hidden="true">
                      {pad(index + 1)}
                    </span>
                    <span class="text-[11px] tracking-[0.14em] text-muted uppercase">
                      Step {index + 1} of {project.steps.length}
                    </span>
                  </p>
                  <h3 class="mt-4 font-display text-xl tracking-wide text-ink uppercase sm:text-2xl">{step.title}</h3>
                  <p class="mt-3 text-[15px] leading-7 text-muted sm:text-base">{step.text}</p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- Previous / next -->
  <nav aria-label="More projects" class="border-t border-line bg-white">
    <div class="wrap grid sm:grid-cols-2">
      <a href={projectUrl(prev)} class="group flex flex-col gap-1 py-8 sm:border-r sm:border-line sm:pr-8">
        <span class="text-[11px] tracking-[0.14em] text-muted uppercase">← Previous project</span>
        <span class="font-bold text-ink transition-colors group-hover:text-brand">{prev.name}</span>
      </a>
      <a
        href={projectUrl(next)}
        class="group flex flex-col gap-1 border-t border-line py-8 sm:border-t-0 sm:pl-8 sm:text-right"
      >
        <span class="text-[11px] tracking-[0.14em] text-muted uppercase">Next project →</span>
        <span class="font-bold text-ink transition-colors group-hover:text-brand">{next.name}</span>
      </a>
    </div>
    <div class="pb-12 text-center">
      <a href="/projects" class="link-underline">View all projects</a>
    </div>
  </nav>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    if (!track || slides.length < 2) return;

    let index = 0;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;

      slides.forEach((slide, i) => {
        const active = i === index;
        slide.setAttribute('aria-hidden', String(!active));
        if (active) slide.removeAttribute('inert');
        else slide.setAttribute('inert', '');
      });

      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
    };

    gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1));
    gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(index + 1));

    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
