---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';
import { projects, projectUrl } from '../../data/projects';

const heroImage =
  'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1600&h=700&q=60';
const ogImage =
  'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=1200&h=630&q=65';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${site.url}/projects#webpage`,
      url: `${site.url}/projects`,
      name: 'Projects | Bunutech Construction',
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#organization` },
      inLanguage: 'en-NG',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: projects.map((project, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: project.name,
          url: `${site.url}${projectUrl(project)}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects` },
      ],
    },
  ],
};
---

<Layout
  title="Projects | Bunutech Construction"
  description="Building and civil engineering projects delivered by Bunutech Construction across Nigeria, from design and drawings through to construction and finishing."
  image={ogImage}
  imageAlt="Bunutech Construction site with cranes in Nigeria"
  jsonLd={structuredData}
>
  <PageHero
    title="Projects"
    description="Selected building and civil engineering work across Nigeria, from first drawings to final handover."
    image={heroImage}
    imageAlt="Construction site with cranes in Nigeria"
  />

  <section aria-labelledby="projects-heading" class="bg-mist py-14 sm:py-16 lg:py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 id="projects-heading" class="eyebrow">Our Work</h2>
          <hr class="rule-brand" />
          <p class="body-copy mt-6">
            Each project page walks through how the work was done, step by step, from planning to completion.
          </p>
        </div>
        <p class="text-[11px] tracking-[0.14em] text-muted uppercase">{projects.length} projects</p>
      </div>

      <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <li>
              <ProjectCard project={project} headingLevel="h3" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16" aria-labelledby="projects-cta-heading">
    <div class="wrap flex flex-col items-start justify-between gap-6 border-l-4 border-brand pl-6 sm:flex-row sm:items-center">
      <div>
        <h2 id="projects-cta-heading" class="font-display text-2xl tracking-wide text-ink uppercase">
          Planning a project?
        </h2>
        <p class="body-copy mt-2">Tell us about it and we will get back to you.</p>
      </div>
      <a href="/contact?subject=Project%20enquiry" class="btn-primary">Start a conversation</a>
    </div>
  </section>
</Layout>
