---
import type { Project } from "../data/projects";
import { projectUrl } from "../data/projects";

interface Props {
    project: Project;
    headingLevel?: "h2" | "h3";
}

const {
    project,
    headingLevel: Heading = "h3",
} = Astro.props;
---

<article class="group relative overflow-hidden bg-ink">
    <img
        src={project.image}
        alt={project.alt}
        width="800"
        height="600"
        class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/30 to-transparent"></div>

    <span class="absolute top-0 left-0 bg-brand px-3 py-1.5 text-[10px] font-bold tracking-[0.14em] text-white uppercase">
        {project.category}
    </span>

    <div class="absolute inset-x-0 bottom-0 p-5">
        <Heading class="text-sm leading-snug font-bold text-white uppercase sm:text-[15px]">
            <a
                href={projectUrl(project)}
                class="after:absolute after:inset-0 focus-visible:outline-none after:focus-visible:outline-2 after:focus-visible:-outline-offset-4 after:focus-visible:outline-white"
            >
                {project.name}
            </a>
        </Heading>
        <p class="mt-1.5 text-[10px] tracking-[0.14em] text-white/75 uppercase">
            {project.location}
        </p>
        <p
            class="mt-3 inline-flex items-center gap-2 text-[11px] font-bold tracking-[0.12em] text-white uppercase"
            aria-hidden="true"
        >
            View project
            <svg
                class="text-brand transition-transform duration-200 group-hover:translate-x-1"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 12h14M13 6l6 6-6 6"
                />
            </svg>
        </p>
    </div>
</article>
