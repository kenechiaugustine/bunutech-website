---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { unsplash } from '../lib/images';

const footerImage = unsplash('1517581177682-a085bb7ffb15', 1600, 900, 55);
const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden bg-ink text-white">
  <img
    src={footerImage}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25"
    width="1600"
    height="900"
    loading="lazy"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/80 via-ink/85 to-ink/95"></div>

  <div class="wrap py-12 sm:py-16">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <Logo inverted />
        <p class="mt-5 text-sm font-bold tracking-wide">RC 1234567</p>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Certifications">
          {
            site.certifications.map((certification) => (
              <li class="border border-white/40 px-2.5 py-2 text-center text-[10px] leading-tight tracking-wide uppercase">
                <span class="block">ISO</span>
                <span class="block">{certification.replace('ISO ', '')}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="md:col-span-4" aria-label="Footer">
        <h2 class="font-display text-lg tracking-wide">Bunu Tech</h2>
        <ul class="mt-4 space-y-1.5 text-[15px] leading-6">
          <li><a class="transition-colors hover:text-white/70" href="/">Home</a></li>
          <li><a class="transition-colors hover:text-white/70" href="/about">About Us</a></li>
          <li><a class="transition-colors hover:text-white/70" href="/#services">Services</a></li>
          <li><a class="transition-colors hover:text-white/70" href="/#projects">Projects</a></li>
          <li><a class="transition-colors hover:text-white/70" href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="md:col-span-4">
        <h2 class="font-display text-lg tracking-wide">Contact Us</h2>
        <address class="mt-4 space-y-0.5 text-[15px] leading-6 not-italic">
          <p>{site.legalName}</p>
          <p>{site.address.street}</p>
          <p>{site.address.locality}</p>
          <p>{site.address.region} – {site.address.country}</p>
          <p class="pt-2">
            Tel.: <a class="transition-colors hover:text-white/70" href={`tel:${site.phoneHref}`}>{site.phone}</a>
          </p>
          <p>
            E-mail: <a class="transition-colors hover:text-white/70" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/40 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm font-bold tracking-wide">© Copyright {year} {site.legalName}</p>

      <div class="flex items-center gap-4">
        <a
          href={site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bunu Tech on LinkedIn"
          class="transition-opacity hover:opacity-70"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
        </a>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Bunu Tech on Instagram"
          class="transition-opacity hover:opacity-70"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
