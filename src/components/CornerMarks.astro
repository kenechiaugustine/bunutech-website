---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div aria-hidden="true" class:list={['pointer-events-none absolute inset-0 z-10', className]}>
  <span class="absolute top-0 right-0 h-12 w-12 border-t-[6px] border-r-[6px] border-brand sm:h-16 sm:w-16 lg:h-20 lg:w-20"></span>
  <span class="absolute bottom-0 left-0 h-12 w-12 border-b-[6px] border-l-[6px] border-brand sm:h-16 sm:w-16 lg:h-20 lg:w-20"></span>
</div>
